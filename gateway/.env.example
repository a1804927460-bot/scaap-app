PORT=3000
NODE_ENV=production
SUPABASE_URL=https://trmbhcniijedpmohkbzx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
REQUIRE_DURABLE_QUOTA=true
ALLOWED_ORIGINS=

# Secrets below must be Railway sealed variables.
QUICKROUTER_API_KEY=REPLACE_ME
ATLASCLOUD_API_KEY=REPLACE_ME
MINIMAX_API_KEY=REPLACE_ME
AI302_KEY=REPLACE_ME
LEGNEXT_API_KEY=REPLACE_ME
AI302_TASK_SECRET=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET
AI_GATEWAY_PUBLIC_URL=https://gateway.example.com
# Optional same-protocol 302-compatible failover routes. Keep secrets in the
# named sealed variables; never put a key value in this JSON. A route is used
# only after an explicit 402/425/429 rejection before task acceptance.
# AI302_BACKUP_ROUTES_JSON=[{"id":"backup-a","baseUrl":"https://backup.example.com","keyEnv":"AI302_BACKUP_A_KEY"}]
# AI302_BACKUP_A_KEY=REPLACE_ME
ENABLE_302_BACKGROUND_REMOVE=true
ENABLE_302_IMAGE_TOOLS=true
ENABLE_302_HUNYUAN3D=true
ENABLE_302_HYPER3D=true
ENABLE_302_TRIPO3D=true
ENABLE_302_TOPAZ=true

# Optional provider registry. The client sends only an id; URLs and key names
# are resolved here on the server. Never put actual keys in this JSON.
# AI_PROVIDERS_JSON=[{"id":"relay-2-image","kind":"image","name":"Relay 2 Image","endpoint":"https://relay.example.com/v1/images/generations?model=gpt-image-1","keyEnv":"RELAY_2_API_KEY"},{"id":"relay-2-chat","kind":"chat","name":"Relay 2 Chat","endpoint":"https://relay.example.com/v1","models":["model-a","model-b"],"keyEnv":"RELAY_2_API_KEY"}]
# A built-in provider can be bound to a same-capability backup without
# repeating its endpoint, protocol, model, or capability matrix. The backup
# entry itself must include its own HTTPS endpoint, protocol, logicalModel,
# and sealed keyEnv, and should be hidden from the client.
# AI_PROVIDERS_JSON=[{"id":"image-1","fallbackProviderIds":["image-1-backup"]},{"id":"image-1-backup","kind":"image","name":"Nano Banana Pro backup","endpoint":"https://backup.example.com/v1beta/models/gemini-3-pro-image-preview:generateContent","keyEnv":"IMAGE_1_BACKUP_KEY","protocol":"gemini-native","logicalModel":"nano-banana-pro","hidden":true}]
# The same structure applies to video and chat ids. A fallback is used only
# when the first route explicitly rejects before accepting the request
# (402/425/429 or a declared channel-unavailable response). Timeouts, 5xx,
# malformed success, accepted task ids, and result download failures never
# replay the paid request to a backup.
