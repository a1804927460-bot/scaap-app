ENABLE_302_BACKGROUND_REMOVE=true
ENABLE_302_IMAGE_TOOLS=true
ENABLE_302_HUNYUAN3D=true
ENABLE_302_HYPER3D=true
ENABLE_302_TOPAZ=true

# Optional provider registry. The client sends only an id; URLs and key names
# are resolved here on the server. Never put actual keys in this JSON.
