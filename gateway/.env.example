PORT=3000
NODE_ENV=production
SUPABASE_URL=https://trmbhcniijedpmohkbzx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
REQUIRE_DURABLE_QUOTA=true
ALLOWED_ORIGINS=

# Secrets below must be Railway sealed variables.
QUICKROUTER_API_KEY=REPLACE_ME
MINIMAX_API_KEY=REPLACE_ME
AI302_KEY=REPLACE_ME
AI302_TASK_SECRET=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET
